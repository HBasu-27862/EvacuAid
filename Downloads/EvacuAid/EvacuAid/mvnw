#!/bin/sh
set -eu
BASEDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER="$BASEDIR/.mvn/wrapper/maven-wrapper.jar"
if [ ! -f "$WRAPPER" ]; then
  echo "Downloading Maven Wrapper bootstrap (internet access needed once)."
  if command -v curl >/dev/null 2>&1; then curl -fsSL https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar -o "$WRAPPER"
  else wget -q https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar -O "$WRAPPER"; fi
fi
exec java -classpath "$WRAPPER" org.apache.maven.wrapper.MavenWrapperMain "$@"
